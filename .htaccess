# MODX supports Friendly URLs via this .htaccess file. You must serve web
# pages via Apache with mod_rewrite to use this functionality, and you must
# change the file name from ht.access to .htaccess.
#
# Make sure RewriteBase points to the directory where you installed MODX.
# E.g., "/modx" if your installation is in a "modx" subdirectory.
#
# You may choose to make your URLs non-case-sensitive by adding a NC directive
# to your rule: RewriteRule ^(.*)$ index.php?q=$1 [L,QSA,NC]

# Repository files are not for the web: .git, _dev (DB dump, scripts), README
RedirectMatch 404 /\.git
RedirectMatch 404 ^/_dev(/|$)
RedirectMatch 404 ^/README\.md$
RedirectMatch 404 /\.user\.ini$

RewriteEngine On
RewriteBase /


# Prevent rewrite the .well-known directory used by LetsEncrypt by rules below of this rule
RewriteRule "^\.well-known/" - [L]


# Prevent dot directories (hidden directories like .git) to be exposed to the public
# Except for the .well-known directory used by LetsEncrypt a.o
RewriteRule "/\.|^\.(?!well-known/)" - [F]


# Rewrite www.example.com -> example.com -- used with SEO Strict URLs plugin
#RewriteCond %{HTTP_HOST} .
#RewriteCond %{HTTP_HOST} ^www.(.*)$ [NC]
#RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
#
# or for the opposite example.com -> www.example.com use the following
# DO NOT USE BOTH
#
#RewriteCond %{HTTP_HOST} !^$
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteCond %{HTTP_HOST} (.+)$
#RewriteRule ^(.*)$ https://www.%1/$1 [R=301,L] .


# Force rewrite to https for every host
#RewriteCond %{HTTPS} !=on [OR]
#RewriteCond %{SERVER_PORT} !^443
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# Redirect the manager to a specific domain - don't rename the ht.access file
# in the manager folder to use this this rule
#RewriteCond %{HTTP_HOST} !^example\.com$ [NC]
#RewriteCond %{REQUEST_URI} ^/manager [NC]
#RewriteRule ^(.*)$ https://example.com/$1 [R=301,L]


# Old site (WordPress, until 2026): Russian was the main language at /, Ukrainian at /ua/, English at /en/.
# Here Ukrainian is the main language at /, Russian is at /ru/. Old pages go to the same pages here.
RewriteRule ^ua/?$ / [R=301,L]
# Russian: /… (and /ru/…) → /ru/…
RewriteRule ^(?:ru/)?(kfc|lego|carnegie-center|intimissimi|calzedonia|globus-bank|domosfera|sun-gallery|vittorio-spernanzoni|arbat-prestige|baldessarini|yus-bar|alsace|cc|hooligan)/?$ /ru/projects/$1/ [R=301,L]
RewriteRule ^(?:ru/)?(?:naruzhnaya-reklama|vyveska|obemnye-bukvy|kryshnye-ystanovki|brandmaueryi|diodnye-ekrany|lajtboksy|bannery|reklamnye-paneli|plotternaya-porezka|lazernaya-rezka|frezernaya-porezka)/?$ /ru/services/outdoor/ [R=301,L]
RewriteRule ^(?:ru/)?(?:interernaya-reklama|tablichki|akrilajty|frejmlajty|izdeliya-iz-akrila|pos-materialy|torgovoe-oborudovanie)/?$ /ru/services/interior/ [R=301,L]
RewriteRule ^(?:ru/)?(?:vkhodnye-gruppy)/?$ /ru/services/entrance/ [R=301,L]
RewriteRule ^(?:ru/)?(?:ventiliruemye-fasady|svetoprozrachnye-konstrukcii)/?$ /ru/services/facades/ [R=301,L]
RewriteRule ^(?:ru/)?(?:design)/?$ /ru/services/design/ [R=301,L]
RewriteRule ^(?:ru/)?(?:mebel-dlya-dizajnerov)/?$ /ru/services/construction/ [R=301,L]
RewriteRule ^(?:ru/)?(?:about-us|vacancy)/?$ /ru/about/ [R=301,L]
RewriteRule ^(?:ru/)?(?:achievements)/?$ /ru/projects/ [R=301,L]
RewriteRule ^(?:ru/)?(?:info)/?$ /ru/blog/ [R=301,L]
# Ukrainian: /ua/… → /…
RewriteRule ^ua/(kfc|lego|carnegie-center|intimissimi|calzedonia|globus-bank|domosfera|sun-gallery|vittorio-spernanzoni|arbat-prestige|baldessarini|yus-bar|alsace|cc|hooligan)/?$ /projects/$1/ [R=301,L]
RewriteRule ^ua/(?:naruzhnaya-reklama|vyveska|obemnye-bukvy|kryshnye-ystanovki|brandmaueryi|diodnye-ekrany|lajtboksy|bannery|reklamnye-paneli|plotternaya-porezka|lazernaya-rezka|frezernaya-porezka)/?$ /services/outdoor/ [R=301,L]
RewriteRule ^ua/(?:interernaya-reklama|tablichki|akrilajty|frejmlajty|izdeliya-iz-akrila|pos-materialy|torgovoe-oborudovanie)/?$ /services/interior/ [R=301,L]
RewriteRule ^ua/(?:vkhodnye-gruppy)/?$ /services/entrance/ [R=301,L]
RewriteRule ^ua/(?:ventiliruemye-fasady|svetoprozrachnye-konstrukcii)/?$ /services/facades/ [R=301,L]
RewriteRule ^ua/(?:design)/?$ /services/design/ [R=301,L]
RewriteRule ^ua/(?:mebel-dlya-dizajnerov)/?$ /services/construction/ [R=301,L]
RewriteRule ^ua/(?:about-us|vacancy)/?$ /about/ [R=301,L]
RewriteRule ^ua/(?:achievements)/?$ /projects/ [R=301,L]
RewriteRule ^ua/(?:info)/?$ /blog/ [R=301,L]
# English: /en/… → /en/…
RewriteRule ^en/(kfc|lego|carnegie-center|intimissimi|calzedonia|globus-bank|domosfera|sun-gallery|vittorio-spernanzoni|arbat-prestige|baldessarini|yus-bar|alsace|cc|hooligan)/?$ /en/projects/$1/ [R=301,L]
RewriteRule ^en/(?:naruzhnaya-reklama|vyveska|obemnye-bukvy|kryshnye-ystanovki|brandmaueryi|diodnye-ekrany|lajtboksy|bannery|reklamnye-paneli|plotternaya-porezka|lazernaya-rezka|frezernaya-porezka)/?$ /en/services/outdoor/ [R=301,L]
RewriteRule ^en/(?:interernaya-reklama|tablichki|akrilajty|frejmlajty|izdeliya-iz-akrila|pos-materialy|torgovoe-oborudovanie)/?$ /en/services/interior/ [R=301,L]
RewriteRule ^en/(?:vkhodnye-gruppy)/?$ /en/services/entrance/ [R=301,L]
RewriteRule ^en/(?:ventiliruemye-fasady|svetoprozrachnye-konstrukcii)/?$ /en/services/facades/ [R=301,L]
RewriteRule ^en/(?:design)/?$ /en/services/design/ [R=301,L]
RewriteRule ^en/(?:mebel-dlya-dizajnerov)/?$ /en/services/construction/ [R=301,L]
RewriteRule ^en/(?:about-us|vacancy)/?$ /en/about/ [R=301,L]
RewriteRule ^en/(?:achievements)/?$ /en/projects/ [R=301,L]
RewriteRule ^en/(?:info)/?$ /en/blog/ [R=301,L]

# Language versions share the files: /en/assets/… and /ru/assets/… → /assets/…
# (the visual editor may save image paths relative to /en/ or /ru/)
RewriteRule ^(?:en|ru)/(assets/.*)$ $1 [L]

# The Friendly URLs part
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]


# For servers that support output compression, you should pick up a bit of
# speed by un-commenting the following lines.
#php_flag zlib.output_compression On
#php_value zlib.output_compression_level 5
